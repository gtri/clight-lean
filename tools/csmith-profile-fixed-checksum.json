{
  "schema_version": 1,
  "profile": "fixed-checksum-floats-v1",
  "generator_argv": [
    "--float",
    "--strict-float",
    "--no-volatiles",
    "--no-bitfields",
    "--no-builtins",
    "--no-argc",
    "--max-struct-fields",
    "6",
    "--no-packed-struct",
    "--no-arg-structs",
    "--no-return-structs",
    "--max-union-fields",
    "3",
    "--no-arg-unions",
    "--no-return-unions",
    "--take-no-union-field-addr",
    "--max-pointer-depth",
    "3",
    "--no-volatile-pointers",
    "--no-const-pointers",
    "--max-array-dim",
    "3",
    "--max-array-len-per-dim",
    "4",
    "--max-funcs",
    "3",
    "--max-block-depth",
    "3",
    "--max-block-size",
    "3",
    "--max-expr-complexity",
    "5",
    "--checksum",
    "--no-hash-value-printf",
    "--concise"
  ],
  "transform_contract": {
    "required_include": "#include \"csmith.h\"",
    "required_include_count": 1,
    "injected_include": "#include \"csmith_checksum_runtime.h\"",
    "final_checksum_call": "platform_main_end(crc32_context ^ 0xFFFFFFFFUL, print_hash_value);",
    "final_checksum_call_count": 1,
    "replacement_call": "csmith_checksum_print((unsigned int)(crc32_context ^ 0xFFFFFFFFUL));",
    "forbid_direct_generated_printf": true,
    "reject_union_abi_functions": true
  }
}
