diff --git a/export/ExportLeanClight.ml b/export/ExportLeanClight.ml
new file mode 100644
index 0000000000000000000000000000000000000000..889dffcb5978be7399bce875c00a5124ca57ac59
--- /dev/null
+++ b/export/ExportLeanClight.ml
@@ -0,0 +1,256 @@
+(* *********************************************************************)
+(*                                                                     *)
+(*              The Compcert verified compiler                         *)
+(*                                                                     *)
+(*  Lean output backend for clightgen (CLight-Lean project)            *)
+(*                                                                     *)
+(*  Mirrors ExportClight.ml, targeting Lean 4 syntax (CLightLean's     *)
+(*  `CLight.lean` port) instead of Coq syntax.                         *)
+(*                                                                     *)
+(* *********************************************************************)
+
+(** Export Clight as a Lean 4 file constructing a
+    [CLightLean.program_type CLightLean.function] term. *)
+
+open Format
+open Camlcoq
+open AST
+open! Ctypes
+open Cop
+open Clight
+open ExportBaseLean
+open ExportCtypesLean
+
+(* Expressions *)
+
+let name_unop = function
+  | Onotbool -> "unary_operation.Onotbool"
+  | Onotint -> "unary_operation.Onotint"
+  | Oneg -> "unary_operation.Oneg"
+  | Oabsfloat -> "unary_operation.Oabsfloat"
+
+let name_binop = function
+  | Oadd -> "binary_operation.Oadd"
+  | Osub -> "binary_operation.Osub"
+  | Omul -> "binary_operation.Omul"
+  | Odiv -> "binary_operation.Odiv"
+  | Omod -> "binary_operation.Omod"
+  | Oand -> "binary_operation.Oand"
+  | Oor -> "binary_operation.Oor"
+  | Oxor -> "binary_operation.Oxor"
+  | Oshl -> "binary_operation.Oshl"
+  | Oshr -> "binary_operation.Oshr"
+  | Oeq -> "binary_operation.Oeq"
+  | Cop.One -> "binary_operation.One"
+  | Olt -> "binary_operation.Olt"
+  | Ogt -> "binary_operation.Ogt"
+  | Ole -> "binary_operation.Ole"
+  | Oge -> "binary_operation.Oge"
+
+let rec expr p = function
+  | Evar(id, t) ->
+      fprintf p "(expr.Evar %a %a)" ident id typ t
+  | Etempvar(id, t) ->
+      fprintf p "(expr.Etempvar %a %a)" ident id typ t
+  | Ederef(a1, t) ->
+      fprintf p "@[<hov 2>(expr.Ederef@ %a@ %a)@]" expr a1 typ t
+  | Efield(a1, f, t) ->
+      fprintf p "@[<hov 2>(expr.Efield@ %a@ %a@ %a)@]" expr a1 ident f typ t
+  | Econst_int(n, t) ->
+      fprintf p "(expr.Econst_int %a %a)" coqint n typ t
+  | Econst_float(n, t) ->
+      fprintf p "(expr.Econst_float %a %a)" coqfloat n typ t
+  | Econst_long(n, t) ->
+      fprintf p "(expr.Econst_long %a %a)" coqint64 n typ t
+  | Econst_single(n, t) ->
+      fprintf p "(expr.Econst_single %a %a)" coqsingle n typ t
+  | Eunop(op, a1, t) ->
+      fprintf p "@[<hov 2>(expr.Eunop %s@ %a@ %a)@]"
+         (name_unop op) expr a1 typ t
+  | Eaddrof(a1, t) ->
+      fprintf p "@[<hov 2>(expr.Eaddrof@ %a@ %a)@]" expr a1 typ t
+  | Ebinop(op, a1, a2, t) ->
+      fprintf p "@[<hov 2>(expr.Ebinop %s@ %a@ %a@ %a)@]"
+         (name_binop op) expr a1 expr a2 typ t
+  | Ecast(a1, t) ->
+      fprintf p "@[<hov 2>(expr.Ecast@ %a@ %a)@]" expr a1 typ t
+  | Esizeof(t1, t) ->
+      fprintf p "(expr.Esizeof %a %a)" typ t1 typ t
+  | Ealignof(t1, t) ->
+      fprintf p "(expr.Ealignof %a %a)" typ t1 typ t
+
+(* Statements.
+
+   Unlike Coq's exporter, we do *not* apply the [Ssequence(Sskip,s2) ->
+   s2]/[Sloop(...) -> Swhile] cosmetic simplifications: emitting the raw
+   AST faithfully means a structural diff against the Coq `.v` output for
+   the same source file is a direct node-for-node comparison (see
+   docs/CLIGHTGEN_LEAN_BACKEND_PLAN.md item 6). *)
+
+let rec stmt p = function
+  | Sskip ->
+      fprintf p "statement.Sskip"
+  | Sassign(e1, e2) ->
+      fprintf p "@[<hov 2>(statement.Sassign@ %a@ %a)@]" expr e1 expr e2
+  | Sset(id, e2) ->
+      fprintf p "@[<hov 2>(statement.Sset %a@ %a)@]" ident id expr e2
+  | Scall(optid, e1, el) ->
+      fprintf p "@[<hov 2>(statement.Scall %a@ %a@ %a)@]"
+        (print_option ident) optid expr e1 (print_list expr) el
+  | Sbuiltin(optid, ef, tyl, el) ->
+      fprintf p "@[<hov 2>(statement.Sbuiltin %a@ %a@ %a@ %a)@]"
+        (print_option ident) optid
+        external_function ef
+        typlist tyl
+        (print_list expr) el
+  | Ssequence(s1, s2) ->
+      fprintf p "@[<hv 2>(statement.Ssequence@ %a@ %a)@]" stmt s1 stmt s2
+  | Sifthenelse(e, s1, s2) ->
+      fprintf p "@[<hv 2>(statement.Sifthenelse %a@ %a@ %a)@]" expr e stmt s1 stmt s2
+  | Sloop(s1, s2) ->
+      fprintf p "@[<hv 2>(statement.Sloop@ %a@ %a)@]" stmt s1 stmt s2
+  | Sbreak ->
+      fprintf p "statement.Sbreak"
+  | Scontinue ->
+      fprintf p "statement.Scontinue"
+  | Sswitch(e, cases) ->
+      fprintf p "@[<hv 2>(statement.Sswitch %a@ %a)@]" expr e lblstmts cases
+  | Sreturn e ->
+      fprintf p "@[<hv 2>(statement.Sreturn %a)@]" (print_option expr) e
+  | Slabel(lbl, s1) ->
+      fprintf p "@[<hv 2>(statement.Slabel %a@ %a)@]" ident lbl stmt s1
+  | Sgoto lbl ->
+      fprintf p "(statement.Sgoto %a)" ident lbl
+
+and lblstmts p = function
+  | LSnil ->
+      (fprintf p "labeled_statements.LSnil")
+  | LScons(lbl, s, ls) ->
+      fprintf p "@[<hv 2>(labeled_statements.LScons %a@ %a@ %a)@]"
+              (print_option coqZ) lbl stmt s lblstmts ls
+
+(* Global definitions *)
+
+let print_function p (id, f) =
+  fprintf p "def f%s : function := {@ " (sanitize (extern_atom id));
+  fprintf p "  fn_return := %a,@ " typ f.fn_return;
+  fprintf p "  fn_callconv := %a,@ " callconv f.fn_callconv;
+  fprintf p "  fn_params := %a,@ " (print_list (print_pair ident typ)) f.fn_params;
+  fprintf p "  fn_vars := %a,@ " (print_list (print_pair ident typ)) f.fn_vars;
+  fprintf p "  fn_temps := %a,@ " (print_list (print_pair ident typ)) f.fn_temps;
+  fprintf p "  fn_body :=@ ";
+  stmt p f.fn_body;
+  fprintf p "@ }@ @ "
+
+let print_globdef p (id, gd) =
+  match gd with
+  | Gfun(Ctypes.Internal f) -> print_function p (id, f)
+  | Gfun(Ctypes.External _) -> ()
+  | Gvar v -> print_variable typ p (id, v)
+
+let print_ident_globdef p = function
+  | (id, Gfun(Ctypes.Internal _f)) ->
+      fprintf p "(%a, globdef.Gfun (fundef_type.Internal f%s))" ident id (sanitize (extern_atom id))
+  | (id, Gfun(Ctypes.External(ef, targs, tres, cc))) ->
+      fprintf p "@[<hov 2>(%a,@ @[<hov 2>globdef.Gfun (fundef_type.External %a@ %a@ %a@ %a))@]@]"
+        ident id external_function ef typlist targs typ tres callconv cc
+  | (id, Gvar _v) ->
+      fprintf p "(%a, globdef.Gvar v%s)" ident id (sanitize (extern_atom id))
+
+(* The prologue *)
+
+let prologue = "\
+import CLightLean.CLight\n"
+
+(* Naming the compiler-generated temporaries occurring in the program
+   (identical in structure to [ExportClight.ml]'s naming pass -- reuses
+   the same [temp_names] table from [ExportBaseLean]). *)
+
+let rec name_expr = function
+  | Evar(_id, _t) -> ()
+  | Etempvar(id, _t) -> name_temporary id
+  | Ederef(a1, _t) -> name_expr a1
+  | Efield(a1, _f, _t) -> name_expr a1
+  | Econst_int(_n, _t) -> ()
+  | Econst_float(_n, _t) -> ()
+  | Econst_long(_n, _t) -> ()
+  | Econst_single(_n, _t) -> ()
+  | Eunop(_op, a1, _t) -> name_expr a1
+  | Eaddrof(a1, _t) -> name_expr a1
+  | Ebinop(_op, a1, a2, _t) -> name_expr a1; name_expr a2
+  | Ecast(a1, _t) -> name_expr a1
+  | Esizeof(_t1, _t) -> ()
+  | Ealignof(_t1, _t) -> ()
+
+let rec name_stmt = function
+  | Sskip -> ()
+  | Sassign(e1, e2) -> name_expr e1; name_expr e2
+  | Sset(id, e2) -> name_temporary id; name_expr e2
+  | Scall(optid, e1, el) ->
+      name_opt_temporary optid; name_expr e1; List.iter name_expr el
+  | Sbuiltin(optid, _ef, _tyl, el) ->
+      name_opt_temporary optid; List.iter name_expr el
+  | Ssequence(s1, s2) -> name_stmt s1; name_stmt s2
+  | Sifthenelse(e, s1, s2) -> name_expr e; name_stmt s1; name_stmt s2
+  | Sloop(s1, s2) -> name_stmt s1; name_stmt s2
+  | Sbreak -> ()
+  | Scontinue -> ()
+  | Sswitch(e, cases) -> name_expr e; name_lblstmts cases
+  | Sreturn (Some e) -> name_expr e
+  | Sreturn None -> ()
+  | Slabel(_lbl, s1) -> name_stmt s1
+  | Sgoto _lbl -> ()
+
+and name_lblstmts = function
+  | LSnil -> ()
+  | LScons(_lbl, s, ls) -> name_stmt s; name_lblstmts ls
+
+let name_function f =
+  List.iter (fun (id, _ty) -> name_temporary id) f.fn_temps;
+  name_stmt f.fn_body
+
+let name_globdef (_id, g) =
+  match g with
+  | Gfun(Ctypes.Internal f) -> name_function f
+  | _ -> ()
+
+let name_program p =
+  List.iter name_globdef p.Ctypes.prog_defs
+
+(* [Archi] instance selection: pin the specific instance matching how
+   clightgen was configured (mirrors `Configuration`/`Archi` on the OCaml
+   side), rather than leaving it generic -- the generated AST is
+   target-specific anyway (compiled for a specific model), and every
+   `Std.TreeMap`-backed proof obligation the file relies on (via
+   [make_program!]'s `by decide`) needs a *concrete* instance to reduce
+   against. CLightLean's `Archi.lean` only models two instances,
+   [x86_64]/[x86_32] -- this backend is scoped to x86 targets for now,
+   matching this repo's current [Archi.lean] coverage. *)
+let archi_instance_name () =
+  if Archi.ptr64 then "x86_64" else "x86_32"
+
+(* All together *)
+
+let print_program p prog sourcefile normalized =
+  Hashtbl.clear temp_names;
+  name_program prog;
+  fprintf p "@[<v 0>";
+  fprintf p "%s" prologue;
+  fprintf p "@ ";
+  fprintf p "attribute [instance] %s@ @ " (archi_instance_name ());
+  print_gen_info ~sourcefile ~normalized ~archi:(archi_instance_name ()) p;
+  define_idents p;
+  List.iter (print_globdef p) prog.Ctypes.prog_defs;
+  fprintf p "def composites : List composite_definition :=@ ";
+  print_list print_composite_definition p prog.prog_types;
+  fprintf p "@ @ ";
+  fprintf p "def global_definitions : List (ident × globdef (fundef_type function) type) :=@ ";
+  print_list print_ident_globdef p prog.Ctypes.prog_defs;
+  fprintf p "@ @ ";
+  fprintf p "def public_idents : List ident :=@ ";
+  print_list ident p prog.Ctypes.prog_public;
+  fprintf p "@ @ ";
+  fprintf p "def prog : program_type function :=@ ";
+  fprintf p "  make_program! function composites global_definitions public_idents %a@ @ "
+            ident prog.Ctypes.prog_main;
+  fprintf p "@]@."
